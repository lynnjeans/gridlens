# Safe default: synthetic fixtures, no network or credentials required.
APP_MODE=fixture
# live search only; set in .env, never in source or documentation.
TAVILY_API_KEY=
# Not used: choose the model in the sidebar from your own account's catalog.
CHATGPT_MODEL_SLUG=
# `gridlens prepare-model` downloads explicitly and records the resolved commit.
# Optionally pin that commit here; runtime never downloads.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_REVISION=
# Defaults to ./models (git-ignored).
LOCAL_MODEL_DIR=
EMBEDDING_DIMENSIONS=384
CHUNK_TOKENS=350
CHUNK_OVERLAP=50
# OAuth tokens are managed by the app outside this repository, not by .env.

