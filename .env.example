EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_REVISION=
EMBEDDING_DIMENSIONS=384
CHUNK_TOKENS=350
CHUNK_OVERLAP=50
# OAuth tokens are managed by the app outside this repository, not by .env.

